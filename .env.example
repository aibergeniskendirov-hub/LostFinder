# Порт, на котором запускается backend-сервер
PORT=3001

# Абсолютный или относительный (от server/) путь к файлу базы данных SQLite
DB_PATH=./data/lostfinder.sqlite

# Папка для загруженных фотографий
UPLOAD_DIR=./uploads

# Максимальный размер фотографии в байтах (5 МБ по умолчанию)
MAX_PHOTO_BYTES=5242880

# Адрес клиента, с которого разрешены CORS-запросы в режиме разработки
CLIENT_ORIGIN=http://localhost:5173
